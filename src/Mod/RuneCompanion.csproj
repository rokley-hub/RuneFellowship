<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.3.16</Version>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RuneCompanion</AssemblyName>
    <ValheimDir Condition="'$(ValheimDir)' == ''">$(VALHEIM_DIR)</ValheimDir>
    <DependencyDir Condition="'$(DependencyDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\dependencies\</DependencyDir>
  </PropertyGroup>
  <Target Name="CheckValheimReference" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ValheimDir)\valheim_Data\Managed\assembly_valheim.dll')" Text="Set ValheimDir (or VALHEIM_DIR) to your licensed Valheim installation. Game assemblies are not included." />
  </Target>
  <ItemGroup>
    <Compile Include="..\Shared\Protocol.cs" Link="Protocol.cs" />
    <Compile Include="..\Shared\CombatPolicy.cs" Link="CombatPolicy.cs" />
    <Reference Include="$(ValheimDir)\valheim_Data\Managed\*.dll" Exclude="$(ValheimDir)\valheim_Data\Managed\System*.dll;$(ValheimDir)\valheim_Data\Managed\mscorlib.dll;$(ValheimDir)\valheim_Data\Managed\netstandard.dll;$(ValheimDir)\valheim_Data\Managed\Mono*.dll"><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(DependencyDir)BepInExPack\BepInExPack_Valheim\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(DependencyDir)BepInExPack\BepInExPack_Valheim\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Jotunn"><HintPath>$(DependencyDir)Jotunn\plugins\Jotunn.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
