<Window x:Class="Rune.Voice.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Rune Fellowship" Width="1440" Height="840" MinWidth="1280" MinHeight="760"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#0B0B09" Foreground="#EEE4CB" FontFamily="Segoe UI" FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Bone" Color="#EEE4CB"/>
        <SolidColorBrush x:Key="Muted" Color="#AFA68F"/>
        <SolidColorBrush x:Key="Gold" Color="#D9A947"/>
        <SolidColorBrush x:Key="Green" Color="#91AF51"/>
        <SolidColorBrush x:Key="Panel" Color="#C91A1915"/>
        <SolidColorBrush x:Key="PanelSoft" Color="#D6201E19"/>
        <SolidColorBrush x:Key="Line" Color="#66583C"/>
        <ImageBrush x:Key="ButtonTexture" ImageSource="Assets/button-background.png" Stretch="Fill"/>

        <Style x:Key="DialogVolumeSlider" TargetType="Slider">
            <Setter Property="Height" Value="32"/><Setter Property="Foreground" Value="{StaticResource Gold}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid Background="Transparent">
                    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#BA964C" Height="5" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Width="20" Height="20"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse x:Name="Knob" Fill="#EEE4CB" Stroke="#BFA16A" StrokeThickness="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Fill" Value="#FFE6A8"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="Fill" Value="#D9A947"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#514C3E" Height="5" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                    </Track>
                    <Border x:Name="FocusRing" BorderBrush="#D9A947" BorderThickness="1" CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/><Setter Property="FontSize" Value="34"/><Setter Property="Foreground" Value="{StaticResource Bone}"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/><Setter Property="FontSize" Value="18"/><Setter Property="Foreground" Value="{StaticResource Bone}"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C7B98F"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="RuneButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Bone}"/><Setter Property="Background" Value="#5426231C"/><Setter Property="BorderBrush" Value="#8066583C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{StaticResource ButtonTexture}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <Border x:Name="ButtonTint" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#D9A947"/><Setter Property="Foreground" Value="#FFE4A0"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonTint" Property="Background" Value="#B817150F"/><Setter TargetName="ButtonTint" Property="Padding" Value="16,9,16,7"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.46"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource RuneButton}">
            <Setter Property="Background" Value="#A134451D"/><Setter Property="BorderBrush" Value="#B89A7A31"/><Setter Property="Foreground" Value="#FFE7A2"/><Setter Property="FontFamily" Value="Georgia"/><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinHeight" Value="66"/><Setter Property="Padding" Value="24,12"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource RuneButton}">
            <Setter Property="Background" Value="#B03B1A15"/><Setter Property="BorderBrush" Value="#B8954B39"/>
        </Style>
        <Style x:Key="SelectedModeButton" TargetType="Button" BasedOn="{StaticResource RuneButton}">
            <Setter Property="Background" Value="#8A453825"/><Setter Property="BorderBrush" Value="{StaticResource Gold}"/><Setter Property="Foreground" Value="#FFE6AE"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Bone}"/><Setter Property="Background" Value="#16000000"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="19,0"/><Setter Property="Margin" Value="13,1"/><Setter Property="MinHeight" Value="38"/><Setter Property="FontFamily" Value="Georgia"/><Setter Property="FontSize" Value="15"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#713A3021"/><Setter TargetName="NavSurface" Property="BorderBrush" Value="#6A6B583B"/><Setter TargetName="NavSurface" Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#FFE0A0"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#A52A241A"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SelectedNavButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="#87453825"/><Setter Property="BorderBrush" Value="#D9A947"/><Setter Property="BorderThickness" Value="3,0,0,0"/><Setter Property="Foreground" Value="#FFE6AE"/>
        </Style>
        <Style x:Key="KeyCaptureButton" TargetType="Button" BasedOn="{StaticResource RuneButton}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="MinWidth" Value="220"/><Setter Property="Padding" Value="12,6"/><Setter Property="ToolTip" Value="Click, then press a key combination. Escape cancels; Backspace disables the shortcut."/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Bone}"/><Setter Property="Background" Value="#D8171714"/><Setter Property="BorderBrush" Value="#8A6A604A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,6"/><Setter Property="CaretBrush" Value="{StaticResource Gold}"/><Setter Property="SelectionBrush" Value="#795E28"/>
            <Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Gold}"/><Setter Property="Background" Value="#F0171714"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Bone}"/><Setter Property="Background" Value="#171714"/><Setter Property="Padding" Value="9,7"/>
            <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#3B311E"/><Setter Property="Foreground" Value="#FFE2A0"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Bone}"/><Setter Property="Background" Value="#171714"/><Setter Property="BorderBrush" Value="#6A604A"/><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" Foreground="{TemplateBinding Foreground}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="31"/></Grid.ColumnDefinitions><ContentPresenter Margin="8,0,4,0" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}"/><TextBlock Grid.Column="1" Text="⌄" Foreground="{StaticResource Gold}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                    </ToggleButton>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border Background="#171714" BorderBrush="#6A604A" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DropDownToggle" Property="BorderBrush" Value="#D9A947"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="DropDownToggle" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Bone}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="30"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="34" Height="20" Margin="0,0,8,0"><Border x:Name="SwitchTrack" Background="#4F484039" BorderBrush="#76654C" BorderThickness="1" CornerRadius="10"/><Ellipse x:Name="SwitchThumb" Width="14" Height="14" Fill="#DED5BF" HorizontalAlignment="Left" Margin="3,0,0,0"/></Grid><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="#7B91AF51"/><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#B5B88F43"/><Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,3,0"/><Setter TargetName="SwitchThumb" Property="Fill" Value="#FFF0C7"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="{StaticResource Bone}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#44381F"/><Setter Property="Foreground" Value="#FFE2A0"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#30291C"/></Trigger></Style.Triggers></Style>
        <Style TargetType="ListViewItem"><Setter Property="Foreground" Value="{StaticResource Bone}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="4"/><Setter Property="MinHeight" Value="34"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#44381F"/><Setter Property="Foreground" Value="#FFE2A0"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#30291C"/></Trigger></Style.Triggers></Style>
        <Style TargetType="GridViewColumnHeader"><Setter Property="Foreground" Value="#CDBE98"/><Setter Property="Background" Value="#242119"/><Setter Property="BorderBrush" Value="#494130"/><Setter Property="BorderThickness" Value="0,0,1,1"/><Setter Property="Padding" Value="8"/></Style>
        <Style x:Key="Surface" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="18"/><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.42" Color="#000000"/></Setter.Value></Setter></Style>
        <Style x:Key="ChromeButton" TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ChromeSurface" Background="{TemplateBinding Background}" CornerRadius="3" Margin="3"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChromeSurface" Property="Background" Value="#62483C2A"/><Setter Property="Foreground" Value="{StaticResource Bone}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ChromeSurface" Property="Background" Value="#A0231E16"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="CloseChromeButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#A84A201A"/><Setter Property="Foreground" Value="#FFF0DF"/></Trigger></Style.Triggers></Style>
    </Window.Resources>

    <Border BorderThickness="0">
        <Border.Background>
            <ImageBrush ImageSource="Assets/ui-background-wpf.png" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" TileMode="None"/>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#D8171611" BorderBrush="#705D492C" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                        <TextBlock Text="ᚱ" Foreground="{StaticResource Gold}" FontFamily="Georgia" FontSize="19" Margin="0,0,10,0"/>
                        <TextBlock Text="RUNE FELLOWSHIP" Foreground="{StaticResource Bone}" FontFamily="Georgia" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" Margin="22,0,7,0"/>
                        <TextBlock x:Name="TitleRuntimeStatus" Text="Rune ready" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource ChromeButton}" Width="44" MinHeight="40" Content="—" Click="Minimize_Click"/>
                        <Button Style="{StaticResource ChromeButton}" Width="44" MinHeight="40" Content="□" Click="Maximize_Click"/>
                        <Button Style="{StaticResource CloseChromeButton}" Width="44" MinHeight="40" Content="×" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="19.5*"/><ColumnDefinition Width="80.5*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#220C0B08" BorderThickness="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="142"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="112"/></Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="ᚱ" Foreground="{StaticResource Gold}" FontFamily="Georgia" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="R U N E" Foreground="{StaticResource Bone}" FontFamily="Georgia" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="F E L L O W S H I P" Foreground="{StaticResource Gold}" FontFamily="Georgia" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <Button x:Name="PlayNav" Style="{StaticResource SelectedNavButton}" Content="▶   Play" Tag="Play" Click="Navigation_Click"/>
                            <Button x:Name="CompanionsNav" Style="{StaticResource NavButton}" Content="♟   Companions" Tag="Companions" Click="Navigation_Click"/>
                            <Button x:Name="ConversationNav" Style="{StaticResource NavButton}" Content="●   Conversation" Tag="Conversation" Click="Navigation_Click"/>
                            <Button x:Name="CommandsNav" Style="{StaticResource NavButton}" Content="⌘   Commands" Tag="Commands" Click="Navigation_Click"/>
                            <Button x:Name="ModsNav" Style="{StaticResource NavButton}" Content="◆   Mods" Tag="Mods" Click="Navigation_Click"/>
                            <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Content="⚙   Settings" Tag="Settings" Click="Navigation_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Margin="19,16" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Green}" Margin="0,4,7,0"/><TextBlock x:Name="SidebarProfile" Text="Your profile" Foreground="#BBD47D" FontSize="11"/></StackPanel>
                            <TextBlock x:Name="SidebarLocal" Text="Qwen local AI" Style="{StaticResource Caption}" Margin="14,5,0,0"/>
                            <TextBlock x:Name="SidebarCloud" Text="ChatGPT commands" Style="{StaticResource Caption}" Margin="14,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="28,22,28,18">
                    <Grid x:Name="PlayPage">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Ready for Valheim" Style="{StaticResource PageTitle}"/><TextBlock Text="Everything is prepared for your next journey." Foreground="{StaticResource Muted}" FontSize="14" Margin="1,7,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="ACTIVE PROFILE" Foreground="{StaticResource Gold}" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="PlayProfileCombo" SelectionChanged="PlayProfileCombo_SelectionChanged"/></StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Button Style="{StaticResource PrimaryButton}" Content="ᚱ   S T A R T   M O D D E D" Click="StartModded_Click"/>
                                <Button Style="{StaticResource RuneButton}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}" Content="Start vanilla" HorizontalAlignment="Center" Margin="0,7,0,0" Click="StartVanilla_Click"/>
                                <TextBlock x:Name="LaunchNotice" Text="" Foreground="{StaticResource Gold}" TextAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource Surface}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="27"/><RowDefinition Height="27"/><RowDefinition Height="27"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="READY TO LAUNCH" Foreground="{StaticResource Gold}" FontSize="11" VerticalAlignment="Center" Margin="17,0"/>
                                    <Border Grid.Row="1" BorderBrush="#383329" BorderThickness="0,1,0,0"><Grid Margin="17,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Valheim" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="ValheimReady" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" Text="●  Ready" Foreground="{StaticResource Green}" TextAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
                                    <Border Grid.Row="2" BorderBrush="#383329" BorderThickness="0,1,0,0"><Grid Margin="17,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Qwen brain" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="LocalReady" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" Text="●  Checking" Foreground="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
                                    <Border Grid.Row="3" BorderBrush="#383329" BorderThickness="0,1,0,0"><Grid Margin="17,0"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="ChatGPT" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="CloudReady" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" Text="●  Checking" Foreground="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
                                    <Border Grid.Row="4" BorderBrush="#383329" BorderThickness="0,1,0,0"><Grid Margin="17,5,17,7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Local voice" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="VoiceReady" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" Text="●  Checking" Foreground="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="VoiceOutput" Text="Output · Checking" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></Grid></Border>
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="COMING WITH YOU" Foreground="{StaticResource Gold}" FontSize="11" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="PlayCompanionCards" Grid.Row="1" ItemHeight="137"/>
                        </Grid>
                        <Border Grid.Row="3" Background="#151510" BorderBrush="#40392B" BorderThickness="1" Padding="14,10">
                            <TextBlock x:Name="ProfileHealthText" Text="Reading profile health…" Foreground="{StaticResource Muted}"/>
                        </Border>
                    </Grid>

                    <Grid x:Name="CompanionsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,18"><TextBlock Text="Companions" Style="{StaticResource PageTitle}"/><Button Style="{StaticResource RuneButton}" Content="＋ New companion" HorizontalAlignment="Right" Width="160" Click="AddCompanion_Click"/></Grid>
                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Surface}" Padding="0"><ListBox x:Name="CompanionRoster" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Bone}" SelectionChanged="CompanionRoster_SelectionChanged"/></Border>
                            <Border Grid.Column="2" Style="{StaticResource Surface}" Padding="20">
                                <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Border Height="200" Background="#0D0D0B"><Image x:Name="CompanionPortrait" Stretch="UniformToFill"/></Border>
                                        <TextBlock x:Name="PortraitTitle" Text="Dwarf" Style="{StaticResource SectionTitle}" Margin="3,12,0,0"/>
                                        <TextBlock x:Name="PortraitDescription" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="3,7,0,0"/>
                                        <TextBlock x:Name="CompanionRuntimeInfo" TextWrapping="Wrap" Foreground="{StaticResource Bone}" Margin="3,18,0,0"/>
                                    </StackPanel>
                                    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CompanionName"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Recognition nickname" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RecognitionName"/></StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="0.78*"/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Appearance" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="AppearanceCombo" SelectionChanged="AppearanceCombo_SelectionChanged"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Voice engine" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="VoiceEngineCombo" SelectionChanged="VoiceEngineCombo_SelectionChanged" ToolTip="Kokoro is fastest. Turbo is expressive English. V3 is expressive and multilingual. Saved per companion."/></StackPanel>
                                            <StackPanel Grid.Column="4"><TextBlock x:Name="VoiceChoiceLabel" Text="Voice · 6 choices" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="VoiceCombo" MaxDropDownHeight="360" SelectionChanged="VoiceCombo_SelectionChanged"/></StackPanel>
                                            <Button Grid.Column="6" x:Name="TestVoiceButton" Style="{StaticResource RuneButton}" Content="Test" Padding="8,4" Margin="0,20,0,0" Click="TestVoice_Click" ToolTip="Quick fixed line with cheerful delivery and a laugh. No AI writing step. Turbo supports a chuckle cue; other engines speak the laugh as text. Works before saving."/>
                                        </Grid>
                                        <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Personality · describe voice, humor, and temperament" Style="{StaticResource FieldLabel}"/><TextBox Grid.Row="1" x:Name="PersonalityBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="PersonalityBox_TextChanged"/><TextBlock Grid.Row="2" x:Name="PersonalityCount" Text="0 / 200 words" HorizontalAlignment="Right" Style="{StaticResource Caption}" Margin="0,3,0,0"/></Grid>
                                        <Grid Grid.Row="3" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="Role" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="RoleCombo"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="Combat style" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="CombatCombo"/></StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Row="4" Margin="0,8,0,0"><TextBlock Text="Conversation frequency" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="FrequencyCombo"/></StackPanel>
                                        <StackPanel Grid.Row="5" Margin="0,10,0,0"><TextBlock Text="Permissions" Style="{StaticResource FieldLabel}"/><WrapPanel x:Name="PermissionsPanel"><CheckBox x:Name="StoredMaterialsCheck" Content="Stored materials" Margin="0,0,22,0"/><CheckBox x:Name="CraftBuildCheck" Content="Craft &amp; build" Margin="0,0,22,0"/><CheckBox x:Name="CookSortCheck" Content="Cook &amp; sort" Margin="0,0,22,0"/><CheckBox x:Name="BossFightCheck" Content="Boss fights"/></WrapPanel>
                                            
                                        </StackPanel>
                                    </Grid>
<Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0" MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CompanionNotice" Foreground="{StaticResource Green}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="12" MaxHeight="48" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"><Button Style="{StaticResource DangerButton}" Content="Remove" Margin="0,0,8,0" Click="RemoveCompanion_Click"/><Button Style="{StaticResource RuneButton}" Content="Save companion" Margin="0,0,8,0" Click="SaveCompanion_Click"/><Button Style="{StaticResource RuneButton}" Content="Summon" Click="SummonCompanion_Click"/></StackPanel></Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="ConversationPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <StackPanel><TextBlock x:Name="ConversationTitle" Text="Conversation with Rune" Style="{StaticResource PageTitle}"/><TextBlock Text="Speech and typed messages for the selected companion appear here." Style="{StaticResource Caption}" Margin="1,5,0,0"/></StackPanel>
                            <TextBlock x:Name="ConversationProvider" Text="Local AI" Foreground="{StaticResource Green}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource Surface}" Padding="0">
                            <TextBox x:Name="ConversationTranscript" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#B911110E" BorderThickness="0" Padding="18"/>
                        </Border>
                        <TextBox Grid.Row="2" x:Name="ConversationInput" MinHeight="46" Margin="0,12,0,0" Padding="12,10" KeyDown="ConversationInput_KeyDown"/>
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal"><Button Style="{StaticResource RuneButton}" Content="Commands" Margin="0,0,8,0" Click="CommandLibrary_Click"/><Button Style="{StaticResource RuneButton}" Content="Task list" Click="TaskList_Click"/><Button Style="{StaticResource RuneButton}" Content="Voice &amp; volume" Margin="8,0,0,0" Click="VoiceVolume_Click"/></StackPanel>
                            <Button x:Name="ConversationSendButton" Style="{StaticResource PrimaryButton}" Content="Send" HorizontalAlignment="Right" Width="110" Padding="12,7" Click="ConversationSend_Click"/>
                        </Grid>
                    </Grid>

                    <Grid x:Name="CommandsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,14"><TextBlock Text="Ask for the outcome" Style="{StaticResource PageTitle}"/><TextBlock Text="Speak naturally to your selected companion. These are examples of intent, not phrases you must memorize." TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="1,5,0,0"/></StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource Surface}" Padding="16" Margin="0,0,0,14">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="1  Describe what you want" Foreground="{StaticResource Gold}" FontWeight="SemiBold"/><TextBlock Text="Name the item, quantity and location when they matter. Make, craft, create and build can describe the same goal." TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="2  Rune interprets your intent" Foreground="{StaticResource Gold}" FontWeight="SemiBold"/><TextBlock Text="She maps your meaning to supported abilities. If details are unclear, she asks. Questions and casual chat should not start work." TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="3  Check the actual progress" Foreground="{StaticResource Gold}" FontWeight="SemiBold"/><TextBlock Text="A direct order runs after game checks. Multi-step plans need review. The overlay shows current work and blockers; a spoken promise is not completion." TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Surface}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="EXPLORE ABILITIES" Foreground="{StaticResource Gold}" FontSize="11" Margin="0,0,0,8"/>
                                <ComboBox Grid.Row="1" x:Name="CommandGroupsCombo" SelectionChanged="CommandGroup_Changed" Margin="0,0,0,10"/>
                                <ListBox Grid.Row="2" x:Name="CommandActionList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Bone}" DisplayMemberPath="Title" SelectionChanged="CommandAction_Changed"/>
                            </Grid></Border>
                            <Border Grid.Column="2" Style="{StaticResource Surface}" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock x:Name="CommandTitle" Style="{StaticResource SectionTitle}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" x:Name="CommandExample" FontSize="20" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,18,0,12"/>
                                <TextBlock Grid.Row="2" x:Name="CommandDescription" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
                                <TextBlock Grid.Row="3" x:Name="CommandHint" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/>
                                <Border Grid.Row="5" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,18,0,0"><TextBlock Text="Stay in control: ‘follow me’ aborts current work; ‘wait here’ stops movement. ‘Clear crafting’ stops crafting and clears its checklist. Tools, recipes, access, terrain and companion permissions still apply. New wording cannot add an unsupported ability." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"/></Border>
                            </Grid></Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="ModsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,12">
                            <StackPanel><TextBlock Text="Mods" Style="{StaticResource PageTitle}"/><TextBlock Text="Manage one independent profile or browse Thunderstore for downloads." Style="{StaticResource Caption}" Margin="1,4,0,0"/></StackPanel>
                            <WrapPanel Margin="0,12,0,0"><Button Style="{StaticResource RuneButton}" Content="New profile" Margin="0,0,8,0" Click="NewProfile_Click"/><Button Style="{StaticResource RuneButton}" Content="Import profile" Margin="0,0,8,0" Click="ImportProfileXml_Click"/><Button x:Name="ExportProfileButton" Style="{StaticResource RuneButton}" Content="Export profile" Margin="0,0,8,0" Click="ExportProfileXml_Click" ToolTip="Back up the selected mod profile, including mods, settings and local blueprints."/><Button x:Name="RemoveProfileButton" Style="{StaticResource DangerButton}" Content="Remove profile" Click="RemoveProfile_Click"/></WrapPanel>
                            <WrapPanel Margin="0,8,0,0"><Button x:Name="InstallRequirementsButton" Style="{StaticResource RuneButton}" Content="Install Rune requirements" Click="InstallRequirements_Click" Margin="0,0,12,0" ToolTip="Download and enable BepInEx, Jötunn, PlanBuild and their dependencies in this profile. Compatible installed versions are kept."/><TextBlock Text="BepInEx · Jötunn · PlanBuild" Style="{StaticResource Caption}" VerticalAlignment="Center"/></WrapPanel>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#A51A1915" CornerRadius="7" Padding="12,8" Margin="0,0,0,9">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="EDITING PROFILE" Foreground="{StaticResource Gold}" FontSize="10"/><TextBlock Text="All changes below apply only to this profile." Style="{StaticResource Caption}"/></StackPanel>
                                <ComboBox Grid.Column="2" x:Name="ModsProfileCombo" SelectionChanged="ModsProfileCombo_SelectionChanged"/>
                                <Button Grid.Column="4" Style="{StaticResource RuneButton}" Content="Locate Valheim" Padding="8,4" Click="LocateValheim_Click"/>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button x:Name="MyProfileModeButton" Style="{StaticResource RuneButton}" Content="My profile" Padding="22,6" Click="MyProfileMode_Click"/>
                            <Button Grid.Column="2" x:Name="BrowseModeButton" Style="{StaticResource RuneButton}" Content="Browse Thunderstore" Padding="22,6" Click="BrowseMode_Click"/>
                            <StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock x:Name="ModsModeTitle" Text="Installed in this profile" Foreground="{StaticResource Bone}" FontWeight="SemiBold"/><TextBlock x:Name="ModsModeHelp" Text="Select a mod to change, configure, update, or remove it." Style="{StaticResource Caption}"/></StackPanel>
                        </Grid>
                        <Grid Grid.Row="3" Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="190"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock x:Name="ModsSearchLabel" Text="Search this profile" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ModsSearchBox" ToolTip="Search the list below" TextChanged="ModsSearchBox_TextChanged"/></StackPanel>
                            <StackPanel Grid.Column="2" x:Name="ProfileFilterPanel"><TextBlock Text="Show" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ModsFilterCombo" SelectionChanged="ModsFilterCombo_SelectionChanged"/></StackPanel>
                            <StackPanel Grid.Column="4" x:Name="ProfileModActions" Orientation="Horizontal" VerticalAlignment="Bottom"><Button x:Name="UpdateAllButton" Style="{StaticResource RuneButton}" Content="Update all" Margin="0,0,7,0" Click="UpdateAllMods_Click"/><Button x:Name="ToggleModButton" Style="{StaticResource RuneButton}" Content="Enable / disable" Margin="0,0,7,0" Click="ToggleMod_Click"/><Button x:Name="RemoveModButton" Style="{StaticResource DangerButton}" Content="Remove mod" Click="RemoveMod_Click"/></StackPanel>
                            <StackPanel Grid.Column="4" x:Name="BrowseModActions" Orientation="Horizontal" VerticalAlignment="Bottom" Visibility="Collapsed"><Button Style="{StaticResource RuneButton}" Content="Refresh online" Margin="0,0,7,0" Click="RefreshCatalog_Click"/><Button x:Name="InstallModButton" Style="{StaticResource RuneButton}" Content="Install selected" Click="InstallMod_Click"/></StackPanel>
                        </Grid>
                        <Border Grid.Row="4" Style="{StaticResource Surface}" Padding="0"><ListView x:Name="ModsList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Bone}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ModsList_SelectionChanged"><ListView.View><GridView><GridViewColumn Header="Mod" DisplayMemberBinding="{Binding Name}" Width="300"/><GridViewColumn Header="Installed" DisplayMemberBinding="{Binding InstalledVersion}" Width="90"/><GridViewColumn Header="Latest" DisplayMemberBinding="{Binding LatestVersion}" Width="90"/><GridViewColumn Header="State" DisplayMemberBinding="{Binding State}" Width="130"/><GridViewColumn Header="Author / package" DisplayMemberBinding="{Binding Id}" Width="280"/></GridView></ListView.View></ListView></Border>
                        <Grid Grid.Row="5" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock x:Name="ModDetailsText" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ModNoticeText" Foreground="{StaticResource Gold}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" x:Name="ProfileModFooter" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ProfileModWebsiteButton" Style="{StaticResource RuneButton}" Content="Open selected page" Margin="0,0,8,0" Click="OpenThunderstore_Click"/><Button x:Name="EditConfigButton" Style="{StaticResource RuneButton}" Content="Edit selected config" Margin="0,0,8,0" Click="EditConfigs_Click"/><Button Style="{StaticResource RuneButton}" Content="Restore profile backup" Click="RestoreBackup_Click"/></StackPanel><StackPanel Grid.Column="1" x:Name="BrowseModFooter" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed"><Button x:Name="ModWebsiteButton" Style="{StaticResource RuneButton}" Content="Open selected page" Click="OpenThunderstore_Click"/></StackPanel></Grid>
                    </Grid>

                    <Grid x:Name="SettingsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Settings" Style="{StaticResource PageTitle}"/><TextBlock Text="Connections first, detailed controls grouped by purpose." Style="{StaticResource Caption}" Margin="1,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0"><Button x:Name="DonateButton" Style="{StaticResource RuneButton}" Content="Donate with PayPal" Click="Donate_Click" ToolTip="Support Rune Fellowship · opens PayPal in your browser. You choose the amount."/><TextBlock Text="Support Rune · rokley@gmail.com" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
                        </Grid>
                        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="16"/><RowDefinition/></Grid.RowDefinitions>
                            <Border Style="{StaticResource Surface}"><StackPanel><TextBlock Text="AI &amp; account" Style="{StaticResource SectionTitle}"/><TextBlock Text="Who should think for your companions?" Style="{StaticResource FieldLabel}" Margin="0,9,0,0"/><ComboBox x:Name="AiModeCombo" SelectionChanged="AiModeCombo_SelectionChanged"><ComboBoxItem Content="Local only · Qwen handles everything" Tag="local"/><ComboBoxItem Content="Split · ChatGPT commands, Qwen conversation" Tag="hybrid"/><ComboBoxItem Content="Full ChatGPT · ChatGPT handles everything" Tag="chatgpt"/></ComboBox><TextBlock x:Name="AiModeHelp" Text="The selected companion voice engine always runs locally." TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,7,0,0"/><TextBlock x:Name="SettingsChatStatus" Text="ChatGPT · checking" Style="{StaticResource Caption}" Margin="0,5,0,0"/><TextBlock x:Name="SettingsLocalStatus" Text="Qwen brain · checking" Style="{StaticResource Caption}" Margin="0,4,0,10"/><WrapPanel><Button Style="{StaticResource RuneButton}" Content="ChatGPT account &amp; model" Margin="0,0,8,8" Click="ChatGptSettings_Click"/><Button x:Name="LocalModelButton" Style="{StaticResource RuneButton}" Content="Qwen model" Margin="0,0,0,8" Click="LocalModelSettings_Click"/></WrapPanel></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Surface}"><StackPanel><TextBlock Text="Voice &amp; language" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="SettingsAudioStatus" Text="Input and output" Style="{StaticResource Caption}" Margin="0,10,0,8"/><ComboBox x:Name="MicrophoneModeCombo" SelectionChanged="MicrophoneModeCombo_SelectionChanged"><ComboBoxItem Content="Microphone off"/><ComboBoxItem Content="Hold to talk"/><ComboBoxItem Content="Always on · local recognition"/></ComboBox><WrapPanel Margin="0,13,0,0"><Button Style="{StaticResource RuneButton}" Content="Audio setup" Margin="0,0,8,0" Click="AudioSettings_Click"/><Button Style="{StaticResource RuneButton}" Content="Language" Click="LanguageSettings_Click"/><Button Style="{StaticResource RuneButton}" Content="Performance" Margin="8,0,0,0" Click="PerformanceSettings_Click"/></WrapPanel></StackPanel></Border>
                            <Border Grid.Row="2" Style="{StaticResource Surface}"><StackPanel><TextBlock Text="Controls" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="KeybindHint" Text="Click a control, then press the key or combination you want." Style="{StaticResource Caption}" Margin="0,5,0,4"/><Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Microphone" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="MicKeyButton" Style="{StaticResource KeyCaptureButton}" Tag="mic" Click="ShortcutButton_Click" PreviewKeyDown="ShortcutButton_PreviewKeyDown" PreviewKeyUp="ShortcutButton_PreviewKeyUp" LostKeyboardFocus="ShortcutButton_LostKeyboardFocus"/><TextBlock Grid.Row="1" Text="Switch companion" Style="{StaticResource FieldLabel}" Margin="0,9,0,5" VerticalAlignment="Center"/><Button Grid.Row="1" Grid.Column="1" x:Name="SwitchKeyButton" Style="{StaticResource KeyCaptureButton}" Tag="switch" Margin="0,6,0,0" Click="ShortcutButton_Click" PreviewKeyDown="ShortcutButton_PreviewKeyDown" PreviewKeyUp="ShortcutButton_PreviewKeyUp" LostKeyboardFocus="ShortcutButton_LostKeyboardFocus"/><TextBlock Grid.Row="2" Text="Show fellowship" Style="{StaticResource FieldLabel}" Margin="0,9,0,5" VerticalAlignment="Center"/><Button Grid.Row="2" Grid.Column="1" x:Name="OverlayKeyButton" Style="{StaticResource KeyCaptureButton}" Tag="overlay" Margin="0,6,0,0" Click="ShortcutButton_Click" PreviewKeyDown="ShortcutButton_PreviewKeyDown" PreviewKeyUp="ShortcutButton_PreviewKeyUp" LostKeyboardFocus="ShortcutButton_LostKeyboardFocus"/><TextBlock Grid.Row="3" Text="Open controls / move overlay" Style="{StaticResource FieldLabel}" Margin="0,9,0,5" VerticalAlignment="Center"/><Button Grid.Row="3" Grid.Column="1" x:Name="ControlsKeyButton" Style="{StaticResource KeyCaptureButton}" Tag="controls" Margin="0,6,0,0" Click="ShortcutButton_Click" PreviewKeyDown="ShortcutButton_PreviewKeyDown" PreviewKeyUp="ShortcutButton_PreviewKeyUp" LostKeyboardFocus="ShortcutButton_LostKeyboardFocus"/></Grid></StackPanel></Border>
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Surface}"><StackPanel><TextBlock Text="Behaviour &amp; diagnostics" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="VoiceRepliesCheck" Content="Spoken replies · off unloads the voice model" Margin="0,9,0,0" Checked="VoiceRepliesCheck_Changed" Unchecked="VoiceRepliesCheck_Changed"/><TextBlock Text="You can still speak commands and read replies when this is off." TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,5,0,8"/><Button Style="{StaticResource RuneButton}" Content="Rune voice volume" HorizontalAlignment="Left" Click="VoiceVolume_Click" Margin="0,0,0,8"/><CheckBox x:Name="GameOrdersCheck" Content="Allow spoken and typed game orders" Checked="GameOrdersCheck_Changed" Unchecked="GameOrdersCheck_Changed"/><WrapPanel Margin="0,13,0,0"><Button Style="{StaticResource RuneButton}" Content="Memory &amp; notes" Margin="0,0,8,8" Click="MemorySettings_Click"/><Button Style="{StaticResource RuneButton}" Content="Session report / issues" Margin="0,0,8,8" Click="SessionReport_Click"/><Button Style="{StaticResource RuneButton}" Content="Command library" Margin="0,0,8,8" Click="CommandLibrary_Click"/><Button Style="{StaticResource RuneButton}" Content="Task list" Margin="0,0,8,8" Click="TaskList_Click"/></WrapPanel></StackPanel></Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#D8171611" BorderBrush="#705D492C" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="34" Height="34" Stroke="{StaticResource Line}" Fill="#20231A"/><TextBlock x:Name="TalkTargetText" Text="Talking to Rune" FontFamily="Georgia" FontSize="16" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    <TextBlock Grid.Column="1" x:Name="MicStateText" Text="●  Always listening" Foreground="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,28,0"/>
                    <Button Grid.Column="2" Style="{StaticResource RuneButton}" x:Name="MuteButton" Content="Mute mic" Padding="12,5" Margin="0,0,8,0" Click="MuteButton_Click"/>
                    <Button Grid.Column="3" Style="{StaticResource RuneButton}" Content="Open conversation" Padding="12,5" Click="OpenConversation_Click"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>

