                                    <TextBlock Text="Review a local session report before sharing it. Rune never uploads logs automatically." TextWrapping="Wrap" Margin="0,10,0,14" />
                                    <WrapPanel>
                                        <Button Content="Review session report" Click="SessionReport_Click" Style="{StaticResource RuneButton}" Margin="0,0,10,10" />
                                        <Button Content="Report a problem" Click="ReportProblem_Click" Style="{StaticResource RuneButton}" Margin="0,0,10,10" />
                                        <Button Content="Player guide" Click="PlayerGuide_Click" Style="{StaticResource RuneButton}" Margin="0,0,10,10" />
                                    </WrapPanel>
                                    <Button x:Name="DonateButton" Style="{StaticResource RuneButton}" Content="Donate with PayPal" Click="Donate_Click" ToolTip="Support Rune Fellowship · opens PayPal in your browser. You choose the amount." HorizontalAlignment="Left" Margin="0,24,0,0" />
                                    <TextBlock Text="Optional support · rokley@gmail.com" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            <Border Grid.Row="2" x:Name="FooterRail" Style="{StaticResource MetalRail}" BorderThickness="0,1,0,0">
                <Grid>
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="19" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True">
                            <Image x:Name="FooterPortrait" Stretch="UniformToFill">
                                <Image.Clip>
                                    <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18" />
                                </Image.Clip>
                            </Image>
                        </Border>
                        <TextBlock x:Name="TalkTargetText" Text="Rune" FontFamily="Georgia" FontSize="16" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ActivityText" Text="Ready" Foreground="{StaticResource Green}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="MicStateText" Text="●  Always listening" Foreground="{StaticResource Green}" VerticalAlignment="Center" Margin="12,0,16,0" FontSize="12" />
                    <Button Grid.Column="2" Style="{StaticResource FooterButton}" x:Name="MuteButton" Content="Mute mic" Margin="0,0,8,0" Click="MuteButton_Click" />
                    <Button Grid.Column="3" Style="{StaticResource FooterButton}" x:Name="FooterConversationButton" Content="Open conversation" Click="OpenConversation_Click" />
                </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
